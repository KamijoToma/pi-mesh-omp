{
  "name": "pi-mesh-extension",
  "version": "0.7.2-omp.2",
  "description": "Pi and omp agent mesh with compiled-host broker startup, session-safe messaging, and file reservations. GitHub-distributed compatibility fork of pi-mesh-extension.",
  "type": "module",
  "license": "MIT",
  "author": "Clément Garrot <clement.garrot.dev@gmail.com> (https://github.com/cgarrot)",
  "keywords": [
    "pi",
    "omp",
    "oh-my-pi",
    "pi-package",
    "pi-extension",
    "mesh",
    "multi-agent",
    "agents",
    "communication",
    "broker",
    "unix-socket",
    "extension"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamijoToma/pi-mesh-omp.git"
  },
  "homepage": "https://github.com/KamijoToma/pi-mesh-omp#readme",
  "bugs": {
    "url": "https://github.com/KamijoToma/pi-mesh-omp/issues"
  },
  "pi": {
    "extensions": [
      "./dist/src/extension/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/KamijoToma/pi-mesh-omp/omp-compat/assets/preview.jpg"
  },
  "omp": {
    "extensions": [
      "./dist/src/extension/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "pimesh": "dist/src/cli/mesh.js"
  },
  "files": [
    "src",
    "dist",
    "!dist/test",
    "skills",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs && tsgo -p tsconfig.json",
    "check": "tsgo --noEmit -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "smoke": "node scripts/mesh-smoke.mjs",
    "ci": "npm run build && node scripts/run-tests.mjs && npm run smoke",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@oh-my-pi/pi-coding-agent": "18.10.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@mariozechner/pi-tui": "^0.73.1",
    "@types/node": "^22.10.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-tui": "*"
  }
}
